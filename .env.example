# B01: Compose reads this example after copying it to .env.
# No credentials, real account identifiers, model identifiers or deployment grants.
# scripts/tasks.py configure creates .env only if absent; never overwrites it.
FINOPS_MODE=local
FINOPS_DATA_SOURCE=synthetic
FINOPS_DEMO_LABEL=DEMO
FINOPS_CURRENCY=USD
# G02 remains open; no approved cost basis is implied by an empty value.
FINOPS_COST_BASIS=
FINOPS_LLM_PROVIDER=mock
FINOPS_AWS_ENABLED=false
# G04/G05 remain open. Leave cloud configuration empty for local development.
AWS_REGION=
BEDROCK_MODEL_ID=
# B01 readiness checks MODE, AWS_ENABLED and LLM_PROVIDER. Other fields are reserved.
# B02 continues to read data/generators/demo_config.json, not this file.
FINOPS_WEB_PORT=18000
GRAFANA_ADMIN_USER=finops-local
# The password is generated in .local/secrets/grafana-admin-password, never here.
