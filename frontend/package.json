{
  "name": "finops-autopilot-web",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
